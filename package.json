{
  "name": "fintech-transferencias-qa",
  "version": "0.1.0",
  "description": "Prototipo de evaluación de transferencias para una FinTech, desarrollado con TDD, linters y una pirámide de automatización de pruebas.",
  "main": "src/servidor.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/servidor.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest pruebas/unitarias",
    "test:integracion": "jest pruebas/integracion",
    "test:e2e": "jest pruebas/e2e",
    "test:cobertura": "jest --coverage",
    "pairwise": "node herramientas/generar-casos.js",
    "verificar": "npm run lint && npm run format:check && npm run test:cobertura",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.9"
  }
}
